# Bu dosyayı .env olarak kopyalayın:  cp .env.example .env
# Anahtarlar boş bırakılırsa ilgili platform otomatik olarak mock veriye düşer.

# --- Genel ---
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./data/sentiment_analyzer.db
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/sentiment

# --- Twitter / X API v2 (https://developer.x.com) ---
TWITTER_BEARER_TOKEN=

# --- Reddit API (https://www.reddit.com/prefs/apps -> "script") ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=SentimentAnalyzer/2.0 by u/your_username

# --- NLP ---
# auto        : OPENAI_API_KEY varsa openai, yoksa huggingface
# huggingface : yerel transformer modelleri (ilk çalıştırmada indirilir)
# openai      : OpenAI API ile sınıflandırma + özet
# lexicon     : model indirmeyen hafif mod (demo / test)
NLP_PROVIDER=auto
SENTIMENT_MODEL_NAME=cardiffnlp/twitter-xlm-roberta-base-sentiment
# SENTIMENT_MODEL_NAME=nlptown/bert-base-multilingual-uncased-sentiment
SUMMARIZER_MODEL_NAME=sshleifer/distilbart-cnn-12-6
ENABLE_ABSTRACTIVE_SUMMARY=true
SENTIMENT_BATCH_SIZE=16

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Dashboard ---
API_URL=http://localhost:8000/api/v1
